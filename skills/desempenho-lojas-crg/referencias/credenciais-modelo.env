# Copie para  Desktop\Segundo Celebro\credenciais-api.env  (FORA da pasta do cofre)
# e preencha. Nunca coloque este arquivo preenchido no Git nem no cofre.
# O coletor regrava sozinho os *_REFRESH_TOKEN renovados.

# --- Lexos (custo) — aponta para o arquivo que já existe
LEXOS_CHAVE_ARQUIVO=~/Desktop/Segundo Celebro/lexos-api.txt.txt

# --- Mercado Livre — app em developers.mercadolivre.com.br (um app, várias contas)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_CONTAS=CRGFESTAS,CRGFESTAS2
ML_CRGFESTAS_REFRESH_TOKEN=
ML_CRGFESTAS2_REFRESH_TOKEN=

# --- Shopee Open Platform — open.shopee.com (app do tipo Seller In House System)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_CONTAS=SHOPEE1,SHOPEE2
SHOPEE_SHOPEE1_SHOP_ID=
SHOPEE_SHOPEE1_REFRESH_TOKEN=
SHOPEE_SHOPEE2_SHOP_ID=
SHOPEE_SHOPEE2_REFRESH_TOKEN=

# --- Amazon SP-API — Seller Central → Aplicativos e serviços → Desenvolver apps (app privado)
AMZ_CLIENT_ID=
AMZ_CLIENT_SECRET=
AMZ_REFRESH_TOKEN=
AMZ_CONTA=Amazon FBA

# --- TikTok Shop Partner Center — partner.tiktokshop.com
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CONTA=TikTok

# --- Shein: sem API aberta ao vendedor; usa o relatório de repasse
